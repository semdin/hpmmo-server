# HPMMO server environment template.
# Install on the VPS as /etc/hpmmo/hpmmo.env with real secrets (chmod 600) and
# reference it from the systemd units. NEVER commit the filled-in file.
#
# Rotation note (plan.md Phase 3): the historical database credentials were
# scrubbed from this repository's history and must be rotated on the server
# during the migration to this layout.

# PostgreSQL connection used by the C++ service (services/cpp).
DATABASE_URL=postgresql://hpmmo:CHANGE_ME@localhost:5432/hpmmo_db
HPMMO_DB_PASSWORD=CHANGE_ME

# Service-to-service token for private endpoints and world server persistence.
# Generate with: openssl rand -hex 32
HPMMO_SERVICE_TOKEN=CHANGE_ME

# World server settings (reads the C++ persistence service)
HPMMO_API_URL=http://127.0.0.1:8081
HPMMO_WORLD_PORT=7777
HPMMO_WORLD_SEED=1337

# Optional overrides
# HPMMO_BIND=0.0.0.0
# HPMMO_HTTP_PORT=8081
# HPMMO_SESSION_TTL_HOURS=24
# HPMMO_TICKET_TTL_SECONDS=60

# --- Phase 6: maintenance and deployment -------------------------------------
# These are read by the world server's admin API and by
# deploy/hpmmo_deploy.sh. See docs/runbook-rollback.md.

# Maintenance API on the world server (loopback only, never a public port).
# HPMMO_ADMIN_PORT=8082
# HPMMO_MAINTENANCE_DRAIN_SECONDS=10
# HPMMO_MAINTENANCE_SAVE_MIN_MS=1000
# HPMMO_MAINTENANCE_ANNOUNCE_MS=10000

# Deployment controller knobs (defaults are fine for the standard layout).
# HPMMO_RELEASES_DIR=/opt/hpmmo/releases
# HPMMO_STATE_DIR=/opt/hpmmo/state
# HPMMO_MAINTENANCE_COUNTDOWN=300
# HPMMO_DRAIN_TIMEOUT=600
# HPMMO_VERIFY_TIMEOUT=90
# HPMMO_SAVE_TIMEOUT=120
# HPMMO_LOCK_WAIT=900
# HPMMO_GODOT=/root/hpmmo/bin/godot_server

# Launcher-facing status endpoint (loopback only; refuses other binds).
# HPMMO_STATUS_HOST=127.0.0.1
# HPMMO_STATUS_PORT=8083

# Synthetic login+join check run during VERIFYING. Optional: without it the
# controller uses <release>/deploy/smoke_client.sh, which needs the world
# project to ship world/server/smoke_client.tscn (or .gd).
# HPMMO_SMOKE_CMD=/opt/hpmmo/bin/smoke_client.sh
# HPMMO_SMOKE_TIMEOUT=60
