# HPMMO server environment template.
# Install on the VPS as /etc/hpmmo/hpmmo.env with real secrets (chmod 600) and
# reference it from the systemd units. NEVER commit the filled-in file.
#
# Rotation note (plan.md Phase 3): the historical database credentials were
# scrubbed from this repository's history and must be rotated on the server
# during the migration to this layout.

# PostgreSQL connection used by the C++ service (services/cpp).
DATABASE_URL=postgresql://hpmmo:CHANGE_ME@localhost:5432/hpmmo_db
HPMMO_DB_PASSWORD=CHANGE_ME

# Service-to-service token for private endpoints and world server persistence.
# Generate with: openssl rand -hex 32
HPMMO_SERVICE_TOKEN=CHANGE_ME

# World server settings (reads the C++ persistence service)
HPMMO_API_URL=http://127.0.0.1:8081
HPMMO_WORLD_PORT=7777
HPMMO_WORLD_SEED=1337

# Optional overrides
# HPMMO_BIND=0.0.0.0
# HPMMO_HTTP_PORT=8081
# HPMMO_SESSION_TTL_HOURS=24
# HPMMO_TICKET_TTL_SECONDS=60
