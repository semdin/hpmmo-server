# HPMMO C++ account/persistence service.
# Installed (with @PLACEHOLDERS@ substituted) by deploy/install_layout.sh.
# The binary and the migrations come from @RELEASES_DIR@/current, so the unit
# never has to be edited for a release.
[Unit]
Description=HPMMO C++ Database & Persistence Microservice
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@RELEASES_DIR@/current/services/cpp
EnvironmentFile=-@ENV_FILE@
EnvironmentFile=-@STATE_DIR@/release.env
ExecStart=@RELEASES_DIR@/current/services/cpp/build/hpmmo_service serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
