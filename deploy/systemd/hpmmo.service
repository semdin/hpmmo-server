# HPMMO Godot headless world server.
# Installed (with @PLACEHOLDERS@ substituted) by deploy/install_layout.sh.
# WorkingDirectory and ExecStart resolve through @RELEASES_DIR@/current, which is
# the only thing a deployment switches - so a release swap needs no unit edit.
[Unit]
Description=HPMMO Dedicated Godot Game World Server
After=network.target hpmmo-db.service
Wants=hpmmo-db.service

[Service]
Type=simple
User=@RUN_USER@
WorkingDirectory=@RELEASES_DIR@/current/world
EnvironmentFile=-@ENV_FILE@
# Written by hpmmo_deploy.sh at switch time: HPMMO_RELEASE_ID / HPMMO_PREVIOUS_RELEASE
EnvironmentFile=-@STATE_DIR@/release.env
ExecStart=@GODOT@ --headless
# A stop or restart saves every character first (the save barrier answers
# within its 15 s ack timeout); a crash still relies on the autosave.
ExecStop=@FLUSH_SCRIPT@
TimeoutStopSec=60
Restart=always
RestartSec=5

# Unprivileged and sandboxed (security audit 2026-11-09): no privilege gain,
# a read-only system (the world writes only its user:// in its home), private /tmp, no kernel or cgroup tunables.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=@RUN_HOME@

[Install]
WantedBy=multi-user.target
