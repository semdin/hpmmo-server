# Runtime data - never commit databases or logs
*.db
*.db-journal
*.log
dist/
__pycache__/
*.pyc
# Godot caches inside world/
.godot/
*.translation

# World import artifacts (regenerated by the import pass from pinned sources)
world/**/*.import
world/**/*.uid
world/assets/models/**/*_texture.png
world/assets/models/**/*.png
